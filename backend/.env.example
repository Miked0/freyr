PORT=5000

# Banco. Sem TURSO_DATABASE_URL, usa o arquivo local backend/database/expenses.db (ou DB_PATH).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Autenticação: usa bcrypt + cookies de sessão assinados. Não requer senha global.
# Em produção, defina SESSION_SECRET para chave de assinatura personalizada.
SESSION_SECRET=

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
